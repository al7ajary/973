# من @BotFather (لا ترفعه على GitHub ولا ترسله في أي محادثة)
BOT_TOKEN=
# آيدي تيلقرام المسموح لهم (افصل بفاصلة). اعرف آيديك من @userinfobot
ALLOWED_USERS=
# لفحص الإملاء (اختياري). بدونه يتخطى الفحص
# فحص الإملاء يشتغل فقط لما تكتب «افحص» في الكابشن (أو SPELL_DEFAULT=on)
SPELL_DEFAULT=off
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# للاستضافة (Webhook). اتركهم فاضيين للتجربة المحلية (Polling)
WEBHOOK_URL=https://example.com
WEBHOOK_SECRET=change-me-long-random
PORT=3000
